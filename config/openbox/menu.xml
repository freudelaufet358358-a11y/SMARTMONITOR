<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="SmartMonitor">
    <item label="ターミナル (xterm)">
      <action name="Execute"><command>xterm</command></action>
    </item>
    <item label="ダッシュボードを再起動">
      <action name="Execute">
        <command>sh -c 'pkill -f google-chrome'</command>
      </action>
    </item>
    <separator/>
    <item label="Openbox を再起動">
      <action name="Restart"/>
    </item>
    <item label="ログアウト">
      <action name="Exit"><prompt>yes</prompt></action>
    </item>
  </menu>
</openbox_menu>
